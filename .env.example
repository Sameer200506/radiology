# ---------------------------------------------------------------------------
# MedAssist AI — environment variables
#
# Copy this file to `.env.local` and fill in the values. `.env.local` is gitignored
# and must never be committed.
#
#   cp .env.example .env.local
#
# Where each value comes from is documented beside each entry.
# ---------------------------------------------------------------------------

# ===========================================================================
# PUBLIC — Firebase web configuration
#
# This block, plus OPENROUTER_API_KEY below, is the ENTIRE required setup.
# No service account, no Admin SDK, no private key. Everything under the
# "OPTIONAL, SERVER-ONLY" heading further down can be left blank.
# ===========================================================================
# Firebase console → Project settings → General → Your apps → SDK setup and
# configuration → Config. These six values are designed to be public: they
# identify the project and authorise the client SDK. Security comes from
# Authentication plus Firestore/Storage Security Rules, never from hiding these.
#
# Do NOT put the service account, private key, or the OpenRouter key here.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# ===========================================================================
# OPTIONAL, SERVER-ONLY - Firebase Admin
# ===========================================================================
# NOT REQUIRED. The web config above is a complete setup: every read and write
# runs through the Firebase client SDK, gated by firestore.rules and
# storage.rules. A Firebase web config cannot authorise server-side writes,
# which is why the data layer lives in the browser rather than in Route Handlers.
#
# These variables are read for exactly one thing: verifying the session cookie
# in /api/auth/session. With them the cookie lasts 5 days; without them it falls
# back to REST token verification and lasts 1 hour. Nothing else changes.
#
# Firebase console - Project settings - Service accounts - Generate new private key.
# On Vercel: paste the JSON into Environment Variables. Escape newlines as \n.

# Option A - the whole service account as one line of JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option B - the individual fields (often easier in a web UI).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Only needed when the Admin SDK cannot derive the bucket from the project id.
FIREBASE_STORAGE_BUCKET=

# ===========================================================================
# SERVER-ONLY - OpenRouter
# ===========================================================================
# https://openrouter.ai/keys - Create key. NEVER prefix this with NEXT_PUBLIC_
# and never reference it from a client component. lib/ai/openrouter.ts imports
# "server-only" so an accidental client import fails the build.
OPENROUTER_API_KEY=

# Primary model. The default is `auto`, which lets OpenRouter route to whichever
# free model is currently healthy. That survives the free tier churning without a
# redeploy. To pin a specific model, set its id here — nothing else changes.
OPENROUTER_MODEL=auto

# Tried when the primary fails: 429 rate limit, 402 quota exhausted, timeout,
# or the model is no longer available. Any different value enables the fallback.
OPENROUTER_FALLBACK_MODEL=auto

# Optional: pin a vision-capable model so uploaded images can be described.
# Leave EMPTY to correctly report that image analysis is unavailable. The app
# never claims to have analysed an image unless one of these resolves to a model
# whose known capabilities include vision.
# Example: google/gemini-2.0-flash-exp:free
OPENROUTER_IMAGE_MODEL=

# Optional tuning. Defaults shown.
OPENROUTER_TIMEOUT_MS=45000
OPENROUTER_MAX_TOKENS=2048

# ===========================================================================
# APP URL
# ===========================================================================
# The deployed origin. Used for OpenRouter's HTTP-Referer header and for
# absolute metadata URLs. Local development: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
